POSTGRES_DB=minishop
POSTGRES_USER=minishop
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_HOST=localhost
